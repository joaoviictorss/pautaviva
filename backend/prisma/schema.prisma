generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Users {
  id                  String           @id
  name                String
  email               String
  emailVerified       Boolean          @default(false)
  image               String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  cpf                 String?          @unique
  role                Role             @default(CITIZEN)
  failedLoginAttempts Int              @default(0)
  lockedUntil         DateTime?
  notifyPollOpened    Boolean          @default(false)
  notifyPollClosing   Boolean          @default(false)
  notifyPollResult    Boolean          @default(false)
  notifyComments      Boolean          @default(false)
  sessions            Sessions[]
  accounts            Accounts[]
  polls               Polls[]
  participations      Participations[]
  pollReminders PollReminders[]
  auditLogs           AuditLogs[]
  comments            Comments[]       @relation("CommentAuthor")
  moderatedComments   Comments[]       @relation("CommentModerator")
  commentReports      CommentReports[] @relation("CommentReporter")
  reviewedReports     CommentReports[] @relation("ReportReviewer")

  @@unique([email])
  @@map("users")
}

model Sessions {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  users     Users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("sessions")
}

model Accounts {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  users                 Users     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("accounts")
}

model Verifications {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

enum Role {
  CITIZEN
  MANAGER
  MODERATOR
  ADMIN
}

enum PollStatus {
  SCHEDULED
  OPEN
  CLOSED
}

enum VoteOption {
  FOR
  AGAINST
  ABSTAIN
}

enum CommentStatus {
  PENDING
  APPROVED
  REJECTED
  REMOVED
}

enum CommentClassification {
  ADEQUATE
  SUSPECT
  INAPPROPRIATE
}

enum CommentReportReason {
  OFFENSIVE_CONTENT
  SPAM
  HATE_SPEECH
  OTHER
}

enum CommentReportStatus {
  PENDING
  DISMISSED
  ACTIONED
}

model Categories {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  polls     Polls[]

  @@map("categories")
}

model Polls {
  id             String           @id @default(uuid())
  title          String
  description    String
  startsAt       DateTime
  endsAt         DateTime
  status         PollStatus       @default(SCHEDULED)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  categoryId     String
  category       Categories       @relation(fields: [categoryId], references: [id])
  createdById    String
  createdBy      Users            @relation(fields: [createdById], references: [id])
  participations Participations[]
  votes          Votes[]
  comments       Comments[]
  reminders      PollReminders[]
  openNoticeSentAt    DateTime?
  closingNoticeSentAt DateTime?

  @@index([status, endsAt])
  @@index([categoryId])
  @@map("polls")
}

model Comments {
  id               String                 @id @default(uuid())
  text             String
  status           CommentStatus          @default(PENDING)
  classification   CommentClassification?
  moderationReason String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  pollId           String
  poll             Polls                  @relation(fields: [pollId], references: [id], onDelete: Cascade)
  authorId         String
  author           Users                  @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  moderatedById    String?
  moderatedBy      Users?                 @relation("CommentModerator", fields: [moderatedById], references: [id], onDelete: SetNull)
  reports          CommentReports[]

  @@index([pollId, status, createdAt])
  @@index([status, createdAt])
  @@map("comments")
}

model CommentReports {
  id           String              @id @default(uuid())
  reason       CommentReportReason
  status       CommentReportStatus @default(PENDING)
  createdAt    DateTime            @default(now())
  reviewedAt   DateTime?
  commentId    String
  comment      Comments            @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reporterId   String
  reporter     Users               @relation("CommentReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reviewedById String?
  reviewedBy   Users?              @relation("ReportReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([commentId, reporterId])
  @@index([status, createdAt])
  @@index([commentId, status])
  @@map("comment_reports")
}

model Participations {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  pollId    String
  poll      Polls    @relation(fields: [pollId], references: [id], onDelete: Cascade)
  userId    String
  user      Users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId])
  @@index([userId])
  @@map("participations")
}

model PollReminders {
  id         String    @id @default(uuid())
  createdAt  DateTime  @default(now())
  notifiedAt DateTime?
  pollId     String
  poll       Polls     @relation(fields: [pollId], references: [id], onDelete: Cascade)
  userId     String
  user       Users     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId])
  @@index([notifiedAt])
  @@index([userId])
  @@map("poll_reminders")
}

model Votes {
  id     String     @id @default(uuid())
  option VoteOption
  pollId String
  poll   Polls      @relation(fields: [pollId], references: [id], onDelete: Cascade)

  @@index([pollId])
  @@map("votes")
}

model AuditLogs {
  id        String   @id @default(uuid())
  action    String
  details   Json?
  createdAt DateTime @default(now())
  actorId   String?
  actor     Users?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  targetId  String?

  @@index([actorId])
  @@index([targetId])
  @@map("audit_logs")
}
