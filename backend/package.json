{
  "name": "backend",
  "version": "1.0.0",
  "description": "PautaViva API - Fastify + Prisma + Socket.io",
  "main": "src/http/server.ts",
  "type": "module",
  "scripts": {
    "dev": "nodemon --legacy-watch --watch src --ext ts --exec tsx src/http/server.ts",
    "build": "tsc",
    "start": "node dist/http/server.js",
    "start:prod": "prisma migrate deploy && node dist/http/server.js",
    "postinstall": "prisma generate",
    "test:requirements": "tsx scripts/verify-functional-features.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "db:seed:demo": "tsx prisma/seed-demo.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@prisma/client": "^6.19.3",
    "better-auth": "^1.7.6",
    "fastify": "^5.12.4",
    "fastify-plugin": "^6.0.0",
    "fastify-type-provider-zod": "^7.0.0",
    "nodemailer": "^10.0.11",
    "pdfkit": "^0.20.2",
    "socket.io": "^4.8.3",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.7",
    "nodemon": "^3.1.14",
    "prisma": "^6.19.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
