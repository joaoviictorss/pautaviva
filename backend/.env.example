PORT=3333
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pautaviva?schema=public"
BETTER_AUTH_SECRET="change-me-min-32-characters-long"
BETTER_AUTH_URL="http://localhost:3333"
CORS_ORIGIN="http://localhost:5173"

# E-mail via SMTP. Sem SMTP_HOST, os e-mails só aparecem no log.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=seu@gmail.com e
# SMTP_PASS=senha de app (myaccount.google.com/apppasswords, exige 2FA).
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
# Opcional; padrão "PautaViva <SMTP_USER>".
MAIL_FROM=""

# Ligue só atrás de proxy reverso, pro rate limit ver o IP real.
TRUST_PROXY=false

# Usuário root (administrador) criado por `npm run db:seed`.
ROOT_ADMIN_NAME="Administrador PautaViva"
ROOT_ADMIN_EMAIL=""
ROOT_ADMIN_PASSWORD=""
